# === Telegram (long-polling) ===
# From @BotFather:
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs (find yours via @userinfobot):
TELEGRAM_ALLOWED_USERS=

# Optional: default chat ID for scheduled/cron deliveries
TELEGRAM_HOME_CHANNEL=

# === LLM provider ===
# Ollama Cloud open models:
OLLAMA_API_KEY=
