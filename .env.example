# === Telegram (long-polling) ===
# From @BotFather:
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs (find yours via @userinfobot):
TELEGRAM_ALLOWED_USERS=

# Optional: default chat ID for scheduled/cron deliveries
TELEGRAM_HOME_CHANNEL=

# === LLM provider (set at least one) ===
# Recommended single-key option (access to 90+ models):
OPENROUTER_API_KEY=
# Or direct provider keys:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
